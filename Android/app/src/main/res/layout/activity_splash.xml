<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <LinearLayout
        android:id="@+id/splashContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <TextView
            android:id="@+id/splashLogo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_logo_mark"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="B"
            android:textColor="@color/onPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.18"
            android:text="放映节目册"
            android:textColor="@color/textSecondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="serif"
            android:letterSpacing="-0.02"
            android:text="BILIDIY"
            android:textColor="@color/textMain"
            android:textSize="38sp"
            android:textStyle="bold" />

        <View
            android:layout_width="168dp"
            android:layout_height="3dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_rule_double" />

        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="@string/splash_tagline"
            android:textColor="@color/textSecondary"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/splashProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="2dp"
            android:layout_marginTop="30dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/splashFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="42dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.08"
        android:text="@string/splash_footer"
        android:textColor="@color/textSecondary"
        android:textSize="10sp" />
</FrameLayout>