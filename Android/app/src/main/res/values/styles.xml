<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.BiliDiy" parent="" />
    <style name="Widget.BiliDiy" parent="" />

    <!-- Type scale：系统字 + 层级，不靠字体炫技 -->
    <style name="TextAppearance.BiliDiy.Display">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textMain</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.BiliDiy.Headline">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textMain</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.BiliDiy.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textMain</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.BiliDiy.Title">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textMain</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.BiliDiy.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/textMain</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="TextAppearance.BiliDiy.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="TextAppearance.BiliDiy.Label">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.BiliDiy.Overline">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/onPrimaryContainer</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <!-- Shape overlays -->
    <style name="RoundedCover">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="RoundedCoverSmall">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="RoundedPoster">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="RoundedEp">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="RoundedHero">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="CircleShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Surfaces：一层卡片，靠 1dp 线与纸底分界，不做投影 -->
    <style name="Widget.BiliDiy.Card">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/radius_md</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">@dimen/card_stroke</item>
        <item name="strokeColor">@color/line</item>
    </style>

    <style name="Widget.BiliDiy.Card.Tonal">
        <item name="cardBackgroundColor">@color/primaryContainer</item>
        <item name="strokeColor">@color/primaryContainer</item>
    </style>

    <style name="Widget.BiliDiy.Card.Flat">
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">@color/surfaceContainer</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.BiliDiy.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/onPrimary</item>
        <item name="backgroundTint">@color/primary</item>
    </style>

    <style name="Widget.BiliDiy.Button.Tonal">
        <item name="android:textColor">@color/onPrimaryContainer</item>
        <item name="backgroundTint">@color/primaryContainer</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/primaryContainer</item>
    </style>

    <style name="Widget.BiliDiy.Button.Outlined">
        <item name="android:textColor">@color/textMain</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/line</item>
    </style>

    <style name="Widget.BiliDiy.Button.Text">
        <item name="android:textColor">@color/textSecondary</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.BiliDiy.IconButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">@dimen/icon_button</item>
        <item name="android:layout_height">@dimen/icon_button</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">8dp</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="backgroundTint">@color/surfaceContainer</item>
        <item name="iconTint">@color/textMain</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.BiliDiy.IconButton.Ghost">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="iconTint">@color/textMain</item>
    </style>

    <style name="Widget.BiliDiy.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surfaceContainer</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/text_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/textSecondary</item>
        <item name="android:textColorHint">@color/textSecondary</item>
    </style>
</resources>
